# Maintainer: Kaspar Tavityan <291175889+KTavityan@users.noreply.github.com>
pkgname=tuwuh
pkgver=0.1.0
pkgrel=1
pkgdesc="File manager with a built-in code editor and terminal"
arch=('x86_64')
url="https://github.com/keletonik/tuwuh"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libappindicator-gtk3' 'librsvg' 'gcc-libs' 'glibc')
makedepends=('rust' 'cargo' 'nodejs' 'npm')
# The keyring is optional at build time but the AI provider settings do nothing
# useful without a Secret Service implementation running.
optdepends=('kwallet: stores AI provider keys via the Secret Service'
            'gnome-keyring: stores AI provider keys via the Secret Service')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  # npm ci needs the committed lockfile; a plain install here would let the
  # dependency tree drift between the build machine and the tag.
  npm ci
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  npm run build
  cargo build --release --manifest-path src-tauri/Cargo.toml --locked
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  npm run typecheck
  cargo test --release --lib --manifest-path src-tauri/Cargo.toml --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "src-tauri/target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "packaging/$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 "src-tauri/icons/32x32.png" \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/$pkgname.png"
  install -Dm644 "src-tauri/icons/64x64.png" \
    "$pkgdir/usr/share/icons/hicolor/64x64/apps/$pkgname.png"
  install -Dm644 "src-tauri/icons/128x128.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/$pkgname.png"
  install -Dm644 "src-tauri/icons/256x256.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/$pkgname.png"
  install -Dm644 "src-tauri/icons/icon.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/$pkgname.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
